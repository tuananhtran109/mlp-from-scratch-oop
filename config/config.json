{
  "data": {
    "raw_dir": "data/raw",
    "val_ratio": 0.1,
    "seed": 42
  },
  "model": {
    "layers": [
      {
        "type": "dense",
        "in_features": 784,
        "out_features": 128,
        "init": "he"
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "rate": 0.2
      },
      {
        "type": "dense",
        "in_features": 128,
        "out_features": 64,
        "init": "he"
      },
      {
        "type": "relu"
      },
      {
        "type": "dense",
        "in_features": 64,
        "out_features": 10,
        "init": "xavier"
      },
      {
        "type": "softmax"
      }
    ]
  },
  "training": {
    "epochs": 15,
    "batch_size": 128,
    "loss": "cross_entropy",
    "optimizer": {
      "name": "adam",
      "lr": 0.001
    },
    "early_stopping": {
      "patience": 3
    }
  },
  "app": {
    "model_path": "models/mnist_mlp",
    "confidence_threshold": 0.6
  }
}
